  "effects": {
    "localContainerBuild": false,
    "clusterMutation": false,
    "fluxReconciliation": false,
    "secretRead": false,
    "civicCaseAuthority": false,
    "civicMutation": false,
    "administrationWrite": false,
    "vote": false,
    "treasury": false
  }
