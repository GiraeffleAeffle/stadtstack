# syntax=docker/dockerfile:1
#
# Closed, dependency-free reference runtime.  Node's built-in TypeScript type
# stripping loads only the reviewed projection contract, transport, and fixed
# synthetic composition root copied below.
FROM node:22.18.0-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e

ARG SOURCE_REPOSITORY
ARG SOURCE_REVISION

LABEL org.opencontainers.image.title="Stadtstack reviewed public knowledge runtime" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="MIT" \
      org.stadtstack.runtime.component="reviewed-public-knowledge" \
      org.stadtstack.runtime.authority-binding="none"

WORKDIR /runtime
COPY src/reviewed-public-knowledge.ts ./reviewed-public-knowledge.ts
COPY src/reviewed-public-knowledge-server.ts ./reviewed-public-knowledge-server.ts
COPY src/staging-reviewed-public-knowledge-runtime.ts ./staging-reviewed-public-knowledge-runtime.ts
COPY src/reviewed-knowledge-runtime-entrypoint.mjs ./start-reviewed-knowledge-runtime.mjs

USER node
EXPOSE 8080
ENTRYPOINT ["node", "--experimental-strip-types", "/runtime/start-reviewed-knowledge-runtime.mjs"]
